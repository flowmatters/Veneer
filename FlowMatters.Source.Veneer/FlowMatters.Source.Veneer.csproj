<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RiverSystem.ApplicationLayer.Interfaces" Private="False" />
    <Reference Include="RiverSystem.Persistence" Private="False" />
    <Reference Include="RiverSystem.PreProcessing" Private="False" />
    <Reference Include="RiverSystem.ScenarioExplorer" Private="False" />
    <Reference Include="RiverSystem" Private="False" />
    <Reference Include="RiverSystem.PluginManager" Private="False" />
    <Reference Include="RiverSystem.Api" Private="False" />
    <Reference Include="RiverSystem.ApplicationLayer.Consumer" Private="False" />
    <Reference Include="RiverSystem.ApplicationLayer.Consumer.Forms" Private="False" />
    <Reference Include="RiverSystem.Controls" Private="False" />
    <Reference Include="RiverSystem.Controls.UI" Private="False" />
    <Reference Include="RiverSystem.Forms.Core" Private="False" />
    <Reference Include="RiverSystem.Forms" Private="False" />
    <Reference Include="RiverSystem.Simulation" Private="False" />
    <Reference Include="TIME" Private="False" />
    <Reference Include="TIME.UI" Private="False" />
    <Reference Include="TIME.ScenarioManagement" Private="False" />
    <Reference Include="TIME.Tools" Private="False" />
    <Reference Include="TIME.Winforms" Private="False" />
    <Reference Include="TIME.Winforms.UI" Private="False" />
    <Reference Include="NetronGraphLib" Private="False" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CoreWCF.WebHttp" />
    <PackageReference Include="IronPython" />
    <PackageReference Include="IronPython.Interpreter" />
    <PackageReference Include="IronPython.StdLib" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.ServiceModel.Primitives" />
    <PackageReference Include="System.ServiceModel.Http" />
    <PackageReference Include="System.Drawing.Common" />
    <!-- Exclude all assets from Mono.Unix (pulled in by IronPython but only used on Unix systems) -->
    <PackageReference Include="Mono.Unix">
      <ExcludeAssets>All</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\*.*" />
    <EmbeddedResource Include="Resources\NodeIcons\*.*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>